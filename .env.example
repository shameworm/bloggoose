# Copy to .env and fill in real values. .env is git-ignored; this file is not,
# so never put real secrets here. Every variable is validated on startup
# (src/config/env.validation.ts) and the app refuses to start if one is wrong.

# development | production | test (defaults to development)
NODE_ENV=development
# Port the HTTP server listens on (defaults to 3000)
PORT=3000

# NestJS Observe - `npx @nestjs/observe link` writes the real key pair
OBSERVE_APP_KEY=your-observe-app-key
OBSERVE_APP_SECRET=your-observe-app-secret
OBSERVE_APP_SERVICE_ID=bloggoose

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=bloggoose
