## Sign up - expect 201
POST http://localhost:3000/auth/signup
Content-Type: application/json

{
    "username": "makarena",
    "email": "johndoe@example.com",
    "password": "Veryoriginal1!"
}

###
## Get users before login - expect 401
GET http://localhost:3000/users

###
## Log in with email - expect 200
POST http://localhost:3000/auth/login
Content-Type: application/json

{
    "login": "johndoe@example.com",
    "password": "Veryoriginal1!"
}

###
## Log in with username - expect 200
POST http://localhost:3000/auth/login
Content-Type: application/json

{
    "login": "makarena",
    "password": "Veryoriginal1!"
}

###
## Get users after login - expect 200
GET http://localhost:3000/users

###
## Wrong password - expect 401 "Invalid login or password"
POST http://localhost:3000/auth/login
Content-Type: application/json

{
    "login": "johndoe@example.com",
    "password": "Wrongpassword1!"
}

###
## Unknown email - expect 401 with the same message
POST http://localhost:3000/auth/login
Content-Type: application/json

{
    "login": "nobody@example.com",
    "password": "Veryoriginal1!"
}

###
## Unknown username - expect 401 with the same message
POST http://localhost:3000/auth/login
Content-Type: application/json

{
    "login": "nobodyatall",
    "password": "Veryoriginal1!"
}

###
## Empty login (@IsNotEmpty) - expect 400
POST http://localhost:3000/auth/login
Content-Type: application/json

{
    "login": "",
    "password": "Veryoriginal1!"
}

###
## Username containing @ on signup - expect 400
POST http://localhost:3000/auth/signup
Content-Type: application/json

{
    "username": "john@example.com",
    "email": "other@example.com",
    "password": "Veryoriginal1!"
}

###
## Log out - expect 204
POST http://localhost:3000/auth/logout
