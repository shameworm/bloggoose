## Create user (valid) - expect 201
POST http://localhost:3000/users
Content-Type: application/json

{
    "displayName": "John Doe",
    "username": "makarena",
    "email": "johndoe@example.com",
    "password": "Veryoriginal1!"
}

###
## No displayName (optional) - expect 201
POST http://localhost:3000/users
Content-Type: application/json

{
    "username": "makarena",
    "email": "johndoe@example.com",
    "password": "Veryoriginal1!"
}

###
## Missing email (@IsNotEmpty) - expect 400
POST http://localhost:3000/users
Content-Type: application/json

{
    "username": "makarena",
    "password": "Veryoriginal1!"
}

###
## Invalid email format (@IsEmail) - expect 400
POST http://localhost:3000/users
Content-Type: application/json

{
    "username": "makarena",
    "email": "johndoe-at-example",
    "password": "Veryoriginal1!"
}

###
## username too short, 7 chars (@MinLength(8)) - expect 400
POST http://localhost:3000/users
Content-Type: application/json

{
    "username": "makaren",
    "email": "johndoe@example.com",
    "password": "Veryoriginal1!"
}

###
## username too long, 26 chars (@MaxLength(25)) - expect 400
POST http://localhost:3000/users
Content-Type: application/json

{
    "username": "makarenaaaaaaaaaaaaaaaaaaa",
    "email": "johndoe@example.com",
    "password": "Veryoriginal1!"
}

###
## password too short, 7 chars (@MinLength(8)) - expect 400
POST http://localhost:3000/users
Content-Type: application/json

{
    "username": "makarena",
    "email": "johndoe@example.com",
    "password": "Ver1!ab"
}

###
## password without uppercase (@Matches) - expect 400
POST http://localhost:3000/users
Content-Type: application/json

{
    "username": "makarena",
    "email": "johndoe@example.com",
    "password": "veryoriginal1!"
}

###
## password without number (@Matches) - expect 400
POST http://localhost:3000/users
Content-Type: application/json

{
    "username": "makarena",
    "email": "johndoe@example.com",
    "password": "Veryoriginal!"
}

###
## password without special character (@Matches) - expect 400
POST http://localhost:3000/users
Content-Type: application/json

{
    "username": "makarena",
    "email": "johndoe@example.com",
    "password": "Veryoriginal1"
}

###
## wrong types: displayName number, email not a string (@IsString) - expect 400
POST http://localhost:3000/users
Content-Type: application/json

{
    "displayName": 123,
    "username": "makarena",
    "email": 456,
    "password": "Veryoriginal1!"
}

###
## empty body, every required field missing - expect 400
POST http://localhost:3000/users
Content-Type: application/json

{}
